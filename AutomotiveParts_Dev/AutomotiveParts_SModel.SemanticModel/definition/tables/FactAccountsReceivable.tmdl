table FactAccountsReceivable
	lineageTag: 8e1c0c40-f365-4019-b590-96f5d4e97151
	sourceLineageTag: [dbo].[FactAccountsReceivable]

	measure 'AR Outstanding' =
			
			SUM (
			    FactAccountsReceivable[OutstandingAmount]
			)
		lineageTag: 41995120-ca8f-4c28-8110-4e2c3f62a4c2

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Overdue AR' =
			
			CALCULATE (
			    [AR Outstanding],
			    FactAccountsReceivable[DaysPastDue] > 0
			)
		lineageTag: 6a0ee3ae-20f3-48dc-a384-a5e8382ddce3

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AR Overdue %' =
			
			DIVIDE (
			    [Overdue AR],
			    [AR Outstanding]
			)
		lineageTag: 4a69d7d3-f01b-44d4-867e-f77c5cfb73eb

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customers Overdue' =
			
			CALCULATE (
			    DISTINCTCOUNT (
			        FactAccountsReceivable[CustomerKey]
			    ),
			    FactAccountsReceivable[DaysPastDue] > 0
			)
		formatString: 0
		lineageTag: fbd07a86-eb80-4a3d-b1bb-5541d020a8c3

		changedProperty = Name

	measure 'Avg Outstanding / Customer' =
			
			DIVIDE (
			    [AR Outstanding],
			    DISTINCTCOUNT (
			        FactAccountsReceivable[CustomerKey]
			    )
			)
		lineageTag: 25302c5c-fbee-4001-83f9-95f3d0760525

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

