table FactSales
	lineageTag: d1d45732-6e8d-42d2-a193-a803aa829ca2
	sourceLineageTag: [dbo].[FactSales]

	measure Revenue =
			
			SUM ( FactSales[NetAmount] )
		lineageTag: ce53b958-ed76-47bf-b002-dd9abb2dcef6

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Cost =
			
			SUM ( FactSales[CostAmount] )
		lineageTag: a2398221-57f6-4e74-bba4-17fec4d5247c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin' =
			
			SUM ( FactSales[GrossMarginAmount] )
		lineageTag: 22a17363-b383-4960-bbed-544f3d083374

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin %' =
			
			DIVIDE (
			    [Gross Margin],
			    [Revenue]
			)
		lineageTag: b2cba44f-325f-4c02-81df-fccc4d80cb48

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Quantity' =
			
			SUM ( FactSales[Quantity] )
		lineageTag: 4915b641-f154-4a39-9431-c9a4d6fe38f2

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Orders =
			
			DISTINCTCOUNT ( FactSales[SalesDocumentId] )
		formatString: 0
		lineageTag: 7c907b25-f31b-40ae-80d1-d30939a469fa

		changedProperty = Name

	measure 'Average Order Value' =
			
			DIVIDE (
			    [Revenue],
			    [Orders]
			)
		lineageTag: 2b70ec6e-9cd5-4ccd-b2a6-c725189676b6

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Selling Price' =
			
			DIVIDE (
			    [Revenue],
			    [Sales Quantity]
			)
		lineageTag: 52ae0bf4-bcc9-4369-a515-47ccd2b7dfcf

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Active Customers' =
			
			DISTINCTCOUNT ( FactSales[CustomerKey] )
		formatString: 0
		lineageTag: 2eab775c-0aef-4909-8f4d-d539bd010934

		changedProperty = Name

	measure 'Revenue YTD' =
			
			TOTALYTD (
			    [Revenue],
			    DimDate[DateValue]
			)
		lineageTag: d78d9e80-171d-499a-88b0-5c29b2cd8267

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue PY' =
			
			CALCULATE (
			    [Revenue],
			    SAMEPERIODLASTYEAR ( DimDate[DateValue] )
			)
		lineageTag: d5dce119-dba9-40af-bdb8-6b3187fefc9c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue YoY %' =
			
			DIVIDE (
			    [Revenue] - [Revenue PY],
			    [Revenue PY]
			)
		lineageTag: 893e4514-2173-4f05-97d3-745a16d337a3

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

