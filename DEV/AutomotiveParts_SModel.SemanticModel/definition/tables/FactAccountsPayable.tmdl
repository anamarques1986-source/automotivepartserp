table FactAccountsPayable
	lineageTag: 3658d7ba-b98f-4eda-99d8-c8341ca92a7e
	sourceLineageTag: [dbo].[FactAccountsPayable]

	measure 'AP Outstanding' =
			
			SUM (
			    FactAccountsPayable[OutstandingAmount]
			)
		lineageTag: 4945ba8d-664a-41a8-84e4-7ae0dedf457a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Overdue AP' =
			
			CALCULATE (
			    [AP Outstanding],
			    FactAccountsPayable[DaysPastDue] > 0
			)
		lineageTag: fba73fd3-5574-4a68-9631-a4b7f60fb6e2

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Active Suppliers' =
			
			CALCULATE (
			    DISTINCTCOUNT (
			        DimSupplier[SupplierKey]
			    ),
			    DimSupplier[ActiveFlag] = TRUE()
			)
		formatString: 0
		lineageTag: e319f90b-2c15-44a3-8b7a-0faec222e94f

		changedProperty = Name

	measure 'AP Overdue %' =
			
			DIVIDE (
			    [Overdue AP],
			    [AP Outstanding]
			)
		lineageTag: c0600249-c1e9-470f-b42c-80973d0617cc

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Outstanding / Supplier' =
			
			DIVIDE (
			    [AP Outstanding],
			    [Active Suppliers]
			)
		lineageTag: 698445fd-1e91-4ad2-b90a-13ad49ddc578

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

