table FactSales
	lineageTag: 4b8eb151-84da-420c-b998-d841104c3d2e
	sourceLineageTag: [dbo].[FactSales]

	measure Revenue =
			
			SUM ( FactSales[NetAmount] )
		lineageTag: c647f3b7-4ce4-41ff-8001-00f51db2d8ac

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Cost =
			
			SUM ( FactSales[CostAmount] )
		lineageTag: 58137232-daf6-4c69-bc32-dbf2140d5bcd

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin' = ```
			
			SUM ( FactSales[GrossMarginAmount] )
			
			```
		lineageTag: ad2fef36-4f7a-4115-8c4f-955b8f4553e7

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin %' =
			
			DIVIDE (
			    [Gross Margin],
			    [Revenue]
			)
		lineageTag: 24e4ceb0-b155-40b5-8dcd-d9648a8b76f1

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Quantity' =
			
			SUM ( FactSales[Quantity] )
		lineageTag: 5584afa7-1a69-4f29-b310-12e5f2aa2c0b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Orders =
			
			DISTINCTCOUNT ( FactSales[SalesDocumentId] )
		formatString: 0
		lineageTag: 5fd71652-37fb-40be-956d-1bcdf20ff36b

		changedProperty = Name

	measure 'Average Order Value' =
			
			DIVIDE (
			    [Revenue],
			    [Orders]
			)
		lineageTag: bc511754-f923-4e73-8321-8fff7d3b427c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Active Customers' =
			
			DISTINCTCOUNT ( FactSales[CustomerKey] )
		formatString: 0
		lineageTag: 2f043c54-89da-42d2-8642-d51f55e72fdc

		changedProperty = Name

	measure 'Revenue YTD' =
			
			TOTALYTD (
			    [Revenue],
			    DimDate[DateValue]
			)
		lineageTag: c68d47ad-0ccc-4314-8a30-420c8eb6b9fe

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue PY' =
			
			CALCULATE (
			    [Revenue],
			    SAMEPERIODLASTYEAR ( DimDate[DateValue] )
			)
		lineageTag: 5bd13c5f-899d-4508-ad43-4ad6a4097c50

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue YoY %' =
			
			DIVIDE (
			    [Revenue] - [Revenue PY],
			    [Revenue PY]
			)
		lineageTag: 8a31e814-6d10-4fee-8527-ce967fe04aed

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Selling Price' =
			
			DIVIDE (
			    [Revenue],
			    [Sales Quantity]
			)
		lineageTag: dd12b6ed-0566-43c4-aa74-a1c59170079a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

