table FactAccountsReceivable
	lineageTag: 9036631b-439c-422a-b873-c5d07c96e0d3
	sourceLineageTag: [dbo].[FactAccountsReceivable]

	measure 'AR Outstanding' =
			
			SUM ( FactAccountsReceivable[OutstandingAmount] )
		lineageTag: afcabbc4-cdba-4dcd-8d33-7eeb4f6f85d6

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Overdue AR' =
			
			CALCULATE (
			    [AR Outstanding],
			    FactAccountsReceivable[DaysPastDue] > 0
			)
		lineageTag: 1dd17136-d222-44cf-972f-734bdcdf4af6

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AR Overdue %' =
			
			DIVIDE (
			    [Overdue AR],
			    [AR Outstanding]
			)
		lineageTag: cbe9ed9d-2d95-498d-b0c9-5eb76ab7d509

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

