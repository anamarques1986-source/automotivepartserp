	measure 'AP Outstanding' =
			
			SUM ( FactAccountsPayable[OutstandingAmount] )
		lineageTag: 234a363f-48d3-41a3-8492-fd1b0dfcaeee

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Overdue AP' =
			
			CALCULATE (
			    [AP Outstanding],
			    FactAccountsPayable[DaysPastDue] > 0
			)
		lineageTag: 80941521-bf66-4f50-9200-efeef5635c0a

		changedProperty = Name

